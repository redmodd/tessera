{
  "name": "tessera-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:agents": "node scripts/sync-agents-md.mjs",
    "sync:agents:check": "node scripts/sync-agents-md.mjs --check",
    "prebuild": "pnpm sync:agents",
    "build": "pnpm --filter='./packages/*' -r build",
    "test": "pnpm sync:agents:check && pnpm -r test",
    "test:e2e": "playwright test",
    "lint": "pnpm -r lint",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@changesets/cli": "^2.31.0",
    "@playwright/test": "^1.59.1",
    "typescript": "^5.7.0",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=20"
  }
}
