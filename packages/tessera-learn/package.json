{
  "name": "tessera-learn",
  "version": "0.0.4",
  "description": "LMS tracking runtime for interactive learning content. One adapter layer (SCORM 1.2, SCORM 2004 4th Edition, cmi5, static Web), your choice of components.",
  "keywords": [
    "svelte",
    "sveltekit",
    "vite",
    "lms",
    "scorm",
    "scorm-1.2",
    "scorm-2004",
    "cmi5",
    "xapi",
    "elearning",
    "education",
    "course"
  ],
  "homepage": "https://github.com/redmodd/tessera#readme",
  "bugs": {
    "url": "https://github.com/redmodd/tessera/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redmodd/tessera.git",
    "directory": "packages/tessera-learn"
  },
  "author": "Derek Redmond <derek.redmond@redmondelearning.ca>",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src",
    "styles",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.ts",
      "import": "./dist/plugin/index.js",
      "default": "./dist/plugin/index.js"
    },
    "./virtual": {
      "types": "./src/virtual.d.ts"
    },
    "./runtime/*": "./src/runtime/*"
  },
  "svelte": "./src/index.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "archiver": "^8.0.0",
    "json5": "^2.0.0",
    "svelte": "^5.55.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^29.0.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.5"
  }
}
