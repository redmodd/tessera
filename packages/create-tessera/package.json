    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:templates": "node scripts/e2e.mjs",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vitest/coverage-v8": "^4.1.7",
    "tessera-learn": "workspace:*",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
