{
  "name": "create-tessera",
  "version": "0.1.0",
  "description": "Scaffold a new Tessera course.",
  "keywords": [
    "tessera",
    "create",
    "scaffold",
    "lms",
    "scorm",
    "cmi5",
    "elearning",
    "course"
  ],
  "homepage": "https://github.com/redmodd/tessera#readme",
  "bugs": {
    "url": "https://github.com/redmodd/tessera/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/redmodd/tessera.git",
    "directory": "packages/create-tessera"
  },
  "author": "Derek Redmond <derek.redmond@redmondelearning.ca>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "create-tessera": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync-templates": "node scripts/sync-templates.mjs",
    "build": "pnpm sync-templates && tsdown",
